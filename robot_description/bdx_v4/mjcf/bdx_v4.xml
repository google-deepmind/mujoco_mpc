<actuator>
  <!-- Left leg - increased stiffness -->
  <position name="left_hip_yaw_joint_motor"   joint="left_hip_yaw_joint"   kp="20" kv="10" forcerange="-15 15" ctrlrange="-0.349066 0.349066"/>
  <position name="left_hip_roll_joint_motor"  joint="left_hip_roll_joint"  kp="250" kv="40" forcerange="-15 15" ctrlrange="-0.698132 0.261799"/>
  <position name="left_hip_pitch_joint_motor" joint="left_hip_pitch_joint" kp="150" kv="15" forcerange="-80 80" ctrlrange="-0.52359 2.356194"/>
  <position name="left_knee_joint_motor"      joint="left_knee_joint"      kp="150" kv="15" forcerange="-80 80" ctrlrange="-2.321287 0"/>
  <position name="left_ankle_joint_motor"     joint="left_ankle_joint"     kp="100" kv="20" forcerange="-100 100" ctrlrange="-1.39626 1.39626"/>

  <!-- Right leg - symmetric -->
  <position name="right_hip_yaw_joint_motor"   joint="right_hip_yaw_joint"   kp="20" kv="10" forcerange="-15 15" ctrlrange="-0.349066 0.349066"/>
  <position name="right_hip_roll_joint_motor"  joint="right_hip_roll_joint"  kp="250" kv="40" forcerange="-15 15" ctrlrange="-0.261799 0.698132"/>
  <position name="right_hip_pitch_joint_motor" joint="right_hip_pitch_joint" kp="150" kv="15" forcerange="-80 80" ctrlrange="-0.52359 2.356194"/>
  <position name="right_knee_joint_motor"      joint="right_knee_joint"      kp="150" kv="15" forcerange="-80 80" ctrlrange="-2.321287 0"/>
  <position name="right_ankle_joint_motor"     joint="right_ankle_joint"     kp="100" kv="20" forcerange="-100 100" ctrlrange="-1.39626 1.39626"/>

  <!-- Neck - keep soft -->
  <position name="neck_forward_joint_motor" joint="neck_forward_joint" kp="50" kv="5.0" forcerange="-10 10" ctrlrange="0 1.53"/>
  <position name="neck_pitch_joint_motor"   joint="neck_pitch_joint"   kp="12" kv="1.2" forcerange="-8 8" ctrlrange="-1.5708 0"/>
  <position name="neck_yaw_joint_motor"     joint="neck_yaw_joint"     kp="12" kv="1.2" forcerange="-8 8" ctrlrange="-1.0472 1.0472"/>
  <position name="neck_roll_joint_motor"    joint="neck_roll_joint"    kp="12" kv="1.2" forcerange="-8 8" ctrlrange="-0.436332 0.436332"/>
</actuator>

  <!-- Add joint damping for stability -->
  <default>
    <joint damping="0.1" />
  </default>

  <sensor>
    <framequat name='orientation' objtype='site' objname='imu_in_body'/>
    <framepos name='position' objtype='site' objname='imu_in_body'/>
    <gyro name="imu_ang_vel" site="imu_in_body" />
    <accelerometer name="imu_lin_acc" site="imu_in_body" />
    <velocimeter name="imu_lin_vel" site="imu_in_body" />
    <subtreeangmom name="root_angmom" body="base_link" />
  </sensor>

  <!-- setup scene -->
  <statistic center="1.0 0.7 1.0" extent="0.8"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>
  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom contype="1" conaffinity="1" name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

